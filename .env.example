# TRACE-X Application
APP_ENV=development
APP_NAME=TRACE-X

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tracex
POSTGRES_USER=tracex
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Evidence storage
STORAGE_BACKEND=local
STORAGE_PATH=./evidence-data

# Phase 11 — AI Investigation Assistant (optional; assistant endpoint
# degrades gracefully to "unavailable" if unset — never commit a real key)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
ASSISTANT_PROVIDER_TIMEOUT_SECONDS=30
ASSISTANT_MAX_EVENTS=40
ASSISTANT_MAX_DETECTIONS=40
ASSISTANT_MAX_IOCS=40
ASSISTANT_MAX_INCIDENTS=20
ASSISTANT_MAX_GRAPH_NODES=40
ASSISTANT_MAX_EVIDENCE=50